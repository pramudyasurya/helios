# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/helios?schema=public"

# AI Provider Configuration
# Supported providers: ollama (default), openai, anthropic, gemini
AI_PROVIDER="ollama"
AI_BASE_URL="http://localhost:11434"
AI_API_KEY=""
AI_MODEL="llama3.2"
AI_TIMEOUT="30000"

# Ollama-specific fallbacks (used when AI_PROVIDER=ollama or unset)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT="30000"

# Security / Network Configuration
# Set to "true" or "1" to allow QA scans targeting localhost / private IP addresses (dev/testing only)
HELIOS_ALLOW_LOCAL_TARGETS="false"
