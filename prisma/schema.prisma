// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Run {
  id          String    @id
  startingUrl String
  status      String
  summary     String
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  finalUrl    String?
  title       String?
  description String?

  trail     Json
  checks    Json
  artifacts Json?
  report    Json?

  brokenImages   Json?
  consoleErrors  Json?
  failedRequests Json?
  loadMetrics    Json?
  evidence       Evidence[]
  pageResults    PageResult[]

  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  origin        String       @default("manual")

  updatedAt DateTime @default(now()) @updatedAt
}

model Project {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  environments Environment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Environment {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  baseUrl   String?
  runs      Run[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
}

enum EvidenceType {
  image
  console
  network
}

enum EvidenceStatus {
  open
  resolved
  ignored
}

model Evidence {
  id          String         @id @default(uuid())
  runId       String
  run         Run            @relation(fields: [runId], references: [id], onDelete: Cascade)
  type        EvidenceType
  content     String
  pageUrl     String
  resourceUrl String?
  status      EvidenceStatus @default(open)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PageResult {
  id             String  @id @default(uuid())
  runId          String
  run            Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  url            String
  depth          Int
  status         String
  statusCode     Int?
  finalUrl       String?
  title          String?
  description    String?
  durationMs     Int?
  artifacts      Json?
  brokenImages   Json?
  consoleErrors  Json?
  failedRequests Json?
  loadMetrics    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
